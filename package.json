{
  "name": "nav-chainlink-functions",
  "version": "1.0.0",
  "description": "NAV updates via Chainlink Functions with offchain wallet listener",
  "scripts": {
    "install:all": "npm install",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia",
    "node": "npx hardhat node",
    "backend": "node backend/server.js",
    "listener": "node scripts/walletListener.js",
    "request:nav": "npx hardhat run scripts/requestNAVUpdate.js --network sepolia",
    "request:nav:local": "npx hardhat run scripts/requestNAVUpdate.js --network localhost",
    "demo": "node scripts/localDemo.js"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.2.0",
    "axios": "^1.6.7",
    "dotenv": "^16.4.1",
    "ethers": "^6.11.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.5",
    "solc": "^0.8.19"
  }
}
