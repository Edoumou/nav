# ─────────────────────────────────────────────────────────────────────────────
# Hardhat / Ethereum
# ─────────────────────────────────────────────────────────────────────────────

# Your deployer/signer private key (no 0x prefix needed, but it's fine with it)
PRIVATE_KEY=your_private_key_here

# RPC endpoint for Sepolia testnet
# Get a free one from Alchemy (https://alchemy.com) or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ─────────────────────────────────────────────────────────────────────────────
# Chainlink Functions
# ─────────────────────────────────────────────────────────────────────────────

# Your Chainlink Functions subscription ID
# Create one at https://functions.chain.link (Sepolia)
CHAINLINK_SUBSCRIPTION_ID=1

# Chainlink Functions Router address on Sepolia
# See https://docs.chain.link/chainlink-functions/supported-networks
CHAINLINK_ROUTER=0xb83E47C2bC239B3bf370bc41e1459A34b41238D0

# Chainlink DON ID for Sepolia (bytes32, hex encoded)
CHAINLINK_DON_ID=0x66756e2d657468657265756d2d7365706f6c69612d3100000000000000000000

# Gas limit for the Chainlink Functions callback
CHAINLINK_CALLBACK_GAS_LIMIT=300000

# ─────────────────────────────────────────────────────────────────────────────
# Backend / NAV API
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express backend listens on
BACKEND_PORT=3000

# Full URL of the NAV API (used by walletListener.js and Chainlink Functions JS)
NAV_API_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Wallet Listener
# ─────────────────────────────────────────────────────────────────────────────

# Wallet address whose inflow/outflow transactions should update NAV
MONITORED_WALLET=0xYourWalletAddressHere

# RPC WebSocket endpoint used by the listener (supports ws:// and http://)
LISTENER_RPC_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ─────────────────────────────────────────────────────────────────────────────
# ERC-20 tokens to monitor (comma-separated contract addresses, optional)
# Leave empty to monitor ETH only
# ─────────────────────────────────────────────────────────────────────────────
ERC20_ADDRESSES=0xTokenAddress1,0xTokenAddress2
